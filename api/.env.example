# Application
APP_ENV=development
APP_URL=http://127.0.0.1:8090

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mir_talal
DB_USER=root
DB_PASSWORD=

# Comma-separated list of origins allowed to call this API.
# Use * only if you intentionally want to allow every origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://mirtalal.web.app

# Opaque admin token lifetime, in days.
AUTH_TOKEN_TTL_DAYS=7

# Contact form throttling per IP address.
CONTACT_RATE_LIMIT_PER_HOUR=5

# Set to true when the API runs behind a reverse proxy / load balancer.
TRUST_PROXY=false

# New-message email notifications.
# Leave MAIL_DSN empty to disable notifications.
# Example: smtp://user:password@smtp.yourhost.com:587
MAIL_DSN=
MAIL_FROM=no-reply@mirtalal.com
CONTACT_NOTIFY_TO=

# Used by: php bin/console app:seed-admin
ADMIN_EMAIL=admin@mirtalal.com
ADMIN_PASSWORD=
ADMIN_NAME="Mir Talal"
