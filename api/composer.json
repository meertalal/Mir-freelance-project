{
    "name": "mirtalal/api",
    "description": "Slim 4 CMS and contact API for the Mir Talal website",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.8",
        "doctrine/orm": "^3.3",
        "monolog/monolog": "^2.9",
        "php-di/php-di": "^6.4",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "symfony/cache": "^7.0",
        "symfony/console": "^7.0",
        "symfony/mailer": "^7.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Migrations\\": "migrations/"
        }
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true
    },
    "scripts": {
        "start": "php -S 127.0.0.1:8090 -t public",
        "migrate": "php bin/console migrations:migrate",
        "seed:admin": "php bin/console app:seed-admin"
    }
}
