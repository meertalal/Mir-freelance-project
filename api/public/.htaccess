<IfModule mod_rewrite.c>
    RewriteEngine On

    DirectoryIndex index.html index.php

    # Preserve admin bearer tokens under CGI/FastCGI hosting.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Let uploaded images, Vite assets, and other real files be served directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Send API requests to the Slim front controller.
    RewriteRule ^api(?:/.*)?$ index.php [QSA,L]

    # React Router handles all remaining website routes in the browser.
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
