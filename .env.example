# Contact form destination (pick ONE approach)

# 1) Local / Laragon PHP endpoint (default)
# VITE_CONTACT_ENDPOINT=/api/contact.php

# 2) Formspree (recommended for Firebase Hosting)
# Create a form at https://formspree.io and paste the form id:
# VITE_FORMSPREE_ID=xxxxxxxx

# 3) Web3Forms
# VITE_WEB3FORMS_ACCESS_KEY=your-access-key

# PHP mail recipient when using api/contact.php on Laragon
# CONTACT_TO_EMAIL=hello@mirtalal.com
