# Base URL of the Slim API that powers the contact form (and admin UI).
# Leave empty in development: Vite proxies /api to http://127.0.0.1:8090.
# In production set the API origin, e.g. VITE_API_URL=https://api.mirtalal.com
VITE_API_URL=

# Optional consent-gated analytics (loaded only after the visitor accepts).
# VITE_ANALYTICS_SRC=https://plausible.io/js/script.js
# VITE_ANALYTICS_DOMAIN=mirtalal.com
